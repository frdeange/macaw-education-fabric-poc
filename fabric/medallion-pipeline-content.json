{
  "properties": {
    "description": "Sequential SQL snapshot and four-source enrichment transformations for the education snapshot.",
    "parameters": {
      "expected_snapshot_date": {
        "type": "String",
        "defaultValue": "2026-11-20"
      },
      "batch_id": {
        "type": "String",
        "defaultValue": "sql-mirror-2026-11-20-v1"
      }
    },
    "activities": [
