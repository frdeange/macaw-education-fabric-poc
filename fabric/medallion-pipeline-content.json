              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60
        },
        "typeProperties": {
          "notebookId": "__BRONZE_ENRICHMENT_NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__",
          "parameters": {
            "expected_snapshot_date": {
              "value": {
                "value": "@pipeline().parameters.expected_snapshot_date",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        }
      },
